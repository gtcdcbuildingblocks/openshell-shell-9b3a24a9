# The keys your agent needs. Copy this file to .env and fill them in:
#
#     cp env.example .env
#
# .env is ignored by git, so your keys stay on your machine.

# Your NVIDIA API key, for Nemotron 3.5 Super VL 120B. Get one at https://build.nvidia.com
NVIDIA_API_KEY=

# Your Tavily API key, for Web Search. Get one at https://app.tavily.com
TAVILY_API_KEY=
